{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "additionalProperties": false,
 "type": "object",
 "properties": {
  "model": {
   "type": "string"
  },
  "mcp_servers": {
   "additionalProperties": {
    "$ref": "#/definitions/RawMcpServerConfig"
   },
   "default": {},
   "type": "object"
  }
 },
 "definitions": {
  "AppToolApproval": {
   "enum": [
    "auto",
    "prompt",
    "writes",
    "approve"
   ],
   "type": "string"
  },
  "LegacyAppPathString": {
   "type": "string"
  },
  "McpServerAuth": {
   "oneOf": [
    {
     "enum": [
      "oauth"
     ],
     "type": "string"
    },
    {
     "enum": [
      "chatgpt"
     ],
     "type": "string"
    },
    {
     "enum": [
      "ema_auth"
     ],
     "type": "string"
    }
   ]
  },
  "McpServerEnvVar": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string"
      },
      "source": {
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    }
   ]
  },
  "McpServerOAuthConfig": {
   "additionalProperties": false,
   "properties": {
    "authorization_server_issuer": {
     "type": "string"
    },
    "callback_port": {
     "format": "uint16",
     "minimum": 0.0,
     "type": "integer"
    },
    "callback_url": {
     "type": "string"
    },
    "client_id": {
     "type": "string"
    },
    "client_secret": {
     "type": "string"
    }
   },
   "type": "object"
  },
  "McpServerToolConfig": {
   "additionalProperties": false,
   "properties": {
    "approval_mode": {
     "allOf": [
      {
       "$ref": "#/definitions/AppToolApproval"
      }
     ]
    },
    "output_token_limit": {
     "format": "uint",
     "minimum": 1.0,
     "type": "integer"
    }
   },
   "type": "object"
  },
  "McpStartupReadiness": {
   "oneOf": [
    {
     "enum": [
      "connection"
     ],
     "type": "string"
    },
    {
     "enum": [
      "catalog"
     ],
     "type": "string"
    }
   ]
  },
  "RawMcpServerConfig": {
   "additionalProperties": false,
   "properties": {
    "args": {
     "default": null,
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "auth": {
     "allOf": [
      {
       "$ref": "#/definitions/McpServerAuth"
      }
     ],
     "default": null
    },
    "bearer_token_env_var": {
     "type": "string"
    },
    "command": {
     "type": "string"
    },
    "cwd": {
     "allOf": [
      {
       "$ref": "#/definitions/LegacyAppPathString"
      }
     ],
     "default": null
    },
    "default_tools_approval_mode": {
     "allOf": [
      {
       "$ref": "#/definitions/AppToolApproval"
      }
     ],
     "default": null
    },
    "disabled_tools": {
     "default": null,
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "enabled": {
     "default": null,
     "type": "boolean"
    },
    "enabled_tools": {
     "default": null,
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "env": {
     "additionalProperties": {
      "type": "string"
     },
     "default": null,
     "type": "object"
    },
    "env_http_headers": {
     "additionalProperties": {
      "type": "string"
     },
     "default": null,
     "type": "object"
    },
    "env_vars": {
     "default": null,
     "items": {
      "$ref": "#/definitions/McpServerEnvVar"
     },
     "type": "array"
    },
    "environment_id": {
     "default": null,
     "type": "string"
    },
    "http_headers": {
     "additionalProperties": {
      "type": "string"
     },
     "type": "object"
    },
    "http_headers_helper": {
     "type": "string"
    },
    "name": {
     "default": null,
     "type": "string"
    },
    "oauth": {
     "allOf": [
      {
       "$ref": "#/definitions/McpServerOAuthConfig"
      }
     ],
     "default": null
    },
    "oauth_resource": {
     "default": null,
     "type": "string"
    },
    "omit_tools_from": {
     "default": null,
     "items": {
      "$ref": "#/definitions/ToolExposureSurface"
     },
     "type": "array"
    },
    "required": {
     "default": null,
     "type": "boolean"
    },
    "scopes": {
     "default": null,
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "startup_readiness": {
     "allOf": [
      {
       "$ref": "#/definitions/McpStartupReadiness"
      }
     ],
     "default": null
    },
    "startup_timeout_ms": {
     "default": null,
     "format": "uint64",
     "minimum": 0.0,
     "type": "integer"
    },
    "startup_timeout_sec": {
     "default": null,
     "format": "double",
     "type": "number"
    },
    "supports_parallel_tool_calls": {
     "default": null,
     "type": "boolean"
    },
    "tool_input_schema_max_bytes": {
     "default": null,
     "format": "uint",
     "minimum": 1.0,
     "type": "integer"
    },
    "tool_timeout_sec": {
     "default": null,
     "format": "double",
     "type": "number"
    },
    "tools": {
     "additionalProperties": {
      "$ref": "#/definitions/McpServerToolConfig"
     },
     "default": null,
     "type": "object"
    },
    "url": {
     "type": "string"
    }
   },
   "type": "object"
  },
  "ToolExposureSurface": {
   "oneOf": [
    {
     "enum": [
      "code_mode"
     ],
     "type": "string"
    },
    {
     "enum": [
      "deferred"
     ],
     "type": "string"
    },
    {
     "enum": [
      "direct"
     ],
     "type": "string"
    }
   ]
  }
 }
}
