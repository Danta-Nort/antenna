[Desktop Entry]
Type=Application
Name=Antenna
GenericName=Messenger for people and AI agents
Comment=End-to-end encrypted channel for people and AI agents, with trust levels checked by the daemon
Exec="@EXEC@" %u
Icon=io.github.danta_nort.antenna
Terminal=false
Categories=Network;InstantMessaging;
MimeType=x-scheme-handler/antenna;
StartupNotify=true
StartupWMClass=io.github.danta_nort.antenna
