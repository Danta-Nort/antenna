(* =====================================================================================================
   NEGATIVE CONTROL F-4: owner A confirms "yes" WITHOUT a code (as in pairing v0 / slice 1).
   Owner A has several invites; the voice does not name the session. An attack is expected: in one invite an honest B
   entered the code and said "it matched", while owner A's "yes" is applied to another invite, where the intermediary (who intercepted
   the link, with TLS broken) reached "B entered the code" (M5) by itself. In v1 the "yes" carries the code (main scenario, Q4 is true).
   ===================================================================================================== *)

(* EXPECT false — Q4 of the main scenario: A's link is active although no owner B accepted the code of this TH *)
query h: bitstring, t: thash, ia: G, ib: G, sk: key;
  event(A_Activated(h, t, ia, ib, sk)) ==> event(B_CodeOK(h, t)).

process
  ( !( new dictA: channel; new matchedA: channel;     (* owner A and everyone they talk to by voice *)
       ( !( new s: linksecret; new ea: eid;
            event InviteCreated(ea);
            out(c, (ea, s));                          (* the link is intercepted *)
            A_tnull(NOCODE, false, s, ea, dictA, matchedA) )
       | !B_tnull(NOCODE, false, c, dictA, matchedA) ) ) )   (* B takes the link from the attacker: it may be substituted *)
